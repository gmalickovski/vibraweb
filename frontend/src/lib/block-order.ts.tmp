// Mapeia os ids "externos" (usados em block_order, na UI) para os ids internos
// de DocumentBlock produzidos por document-builder.ts.
export const BLOCK_ID_MAP: Record<string, string> = {
  capa: 'bloco-capa',
  orientacao: 'bloco-orientacao',
  importante: 'bloco-importante',
  os_seus_numeros: 'bloco-numeros',
  essencia: 'bloco-essencia',
  caminho_desafios: 'bloco-caminho',
  ciclos_tempo: 'bloco-ciclos',
  relacionamentos: 'bloco-relacionamentos',
  conclusao: 'bloco-conclusao',
}

// Mapeia os 2 sub-blocos reordenáveis de "Caminho e Desafios" para os ids
// internos usados dentro do array filhosCaminho em document-builder.ts.
export const CHILD_ID_MAP: Record<string, string> = {
  licoes_carmicas: 'licoes',
  debitos_carmicos: 'debitos',
}

// Reconcilia uma ordem salva (possivelmente antiga, de antes de um bloco novo
// existir — ex: perfis salvos antes da separação de Orientação/Importante/Os
// Seus Números em blocos próprios) com a ordem padrão atual. Qualquer id que
// exista em `defaultOrder` mas não em `saved` é inserido na MESMA posição
// relativa do padrão (antes do próximo id conhecido), em vez de simplesmente
// cair no fim da lista — que era o bug: blocos novos apareciam depois de
// Conclusão ao invés de logo após a Capa. Guilherme, 2026-07-12.
function mergeWithDefaultOrder(saved: string[], defaultOrder: string[]): string[] {
  const missing = defaultOrder.filter(id => !saved.includes(id))
  if (missing.length === 0) return saved

  const result = [...saved]
  for (const id of missing) {
    const defaultIdx = defaultOrder.indexOf(id)
    let insertBeforeId: string | undefined
    for (let i = defaultIdx + 1; i < defaultOrder.length; i++) {
      if (result.includes(defaultOrder[i])) { insertBe