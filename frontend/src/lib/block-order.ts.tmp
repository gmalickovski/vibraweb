// block-order.ts — shared config for "Blocos do Relatório" (Item 1, Fase 1).
// Defines which of the 5 top-level report blocks — and which 2 sub-blocos de
// "O Caminho e os Desafios" (Lições Cármicas, Débitos Cármicos) — o consultor
// pode reordenar/ocultar em /app/blocos, e o valor padrão usado quando o perfil
// ainda não tem `block_order` salvo (compatibilidade com perfis existentes).
//
// Decisão de produto (Guilherme, 2026-07-11 — ver Produto/docs/vibra-web/requisitos.md,
// seção 1): os sub-blocos de "Caminho e Desafios" ganham controle individual de
// ordem/visibilidade, não só o bloco pai.

export interface ChildBlockOrder {
  order: string[]
  hidden: string[]
}

export interface BlockOrderConfig {
  order: string[]
  hidden: string[]
  children?: Record<string, ChildBlockOrder>
}

export const DEFAULT_BLOCK_ORDER: BlockOrderConfig = {
  order: [
    'capa',
    'orientacao',
    'importante',
    'os_seus_numeros',
    'essencia',
    'caminho_desafios',
    'ciclos_tempo',
    'relacionamentos',
    'conclusao',
  ],
  hidden: [],
  children: {
    caminho_desafios: {
      order: ['licoes_carmicas', 'debitos_carmicos'],
      hidden: [],
    },
  },
}

export interface BlockDef {
  id: string
  label: string
  description: string
  /** true if this block can never be hidden (only reordered) */
  lockedVisible?: boolean
  children?: BlockDef[]
}

